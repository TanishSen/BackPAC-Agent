# Copy to .env and fill in. Never commit .env.
# The agent refuses to start, naming the variable, if a required key is missing.

LOG_LEVEL=INFO
PORT=8080

# --- Claude (the brain) ------------------------------------------------------
# Haiku routes + runs trains/flights; Sonnet runs stays. See src/bot/core/llm.py.
ANTHROPIC_API_KEY=

# --- LiveKit -----------------------------------------------------------------
# MUST be the same project BackPAC-BE mints rooms in. Different projects means
# the agent joins a room the phone cannot see, and the call connects to nobody.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: the URL THIS process uses to reach LiveKit. The app keeps
# LIVEKIT_URL above, so phones are still routed to their nearest edge.
# Set this when the project URL is slow to connect from your server — on this
# network it takes ~12s (two five-second timeouts before a fallback answers),
# against ~1.1s naming a working region directly. Unset it to go back to the
# default. Check the agent log for "Connecting to" / "Connected to" timings.
# LIVEKIT_AGENT_URL=

# --- ElevenLabs (the voice) --------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # the voice you picked — an id like 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_v3
# Optional voice tuning (leave blank for ElevenLabs defaults):
ELEVENLABS_SPEED=
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=

# --- STT ---------------------------------------------------------------------
# azure  = server-side Azure STT (needs the two keys below), in the language
#          set by STT_LANGUAGES.
# device = the phone transcribes and posts the text over the data channel;
#          no Azure needed. Same entry point as the app's keyboard.
STT_MODE=azure
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=
# Comma-separated BCP-47 codes. One code = Azure is TOLD the language, which is
# the default and the reliable choice. Several = Azure guesses from the first
# utterance and locks to it — and the first utterance is often the agent's own
# greeting echoing off a speaker, after which English comes back transliterated
# into Devanagari. Only widen this if you actually need it.
STT_LANGUAGES=en-IN

# --- barge-in ----------------------------------------------------------------
# true: only a real transcription interrupts the agent. Recommended — raw voice
# activity also fires on background noise and on the agent's own voice echoing
# back off a phone speaker, which cuts it off mid-sentence.
INTERRUPT_ON_TRANSCRIPTION_ONLY=true
# true: the agent cannot be interrupted at all. Occasionally useful for a demo.
DISABLE_INTERRUPTIONS=false

# Milliseconds of TTS audio buffered before playback starts. Higher is smoother
# under a bad network but adds exactly that much delay to the first word.
# Clamped to 150–500.
TTS_JITTER_BUFFER_MS=200

# --- ai-coustics noise filter (optional) -------------------------------------
# Only used if the proprietary `ai-coustics` SDK is installed. Without it the
# pipeline falls back to Silero VAD and these are ignored.
AIC_SDK_LICENSE=
AIC_ENHANCEMENT_LEVEL=0.8
AIC_VAD_SENSITIVITY=3.5
AIC_VAD_HOLD_DURATION=1.5
AIC_VAD_MIN_SPEECH_DURATION=0.4

# --- where the backend lives (the search tools call it) ----------------------
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=15

# --- scripts/call_agent.py only ----------------------------------------------
# The voice that plays the "caller" in `make call`. Pick something different
# from ELEVENLABS_VOICE_ID so the two sides are easy to tell apart.
CALLER_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Copy to .env and fill in. Never commit .env.

LOG_LEVEL=INFO
PORT=8080

# --- Claude (the brain) ---
# Haiku for routing/specialists, Sonnet for heavy planning. See src/bot/core/llm.py.
ANTHROPIC_API_KEY=

# --- LiveKit: MUST be the same project BackPAC-BE mints rooms in ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- ElevenLabs (the voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # the voice you picked — an id like 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_v3
# Optional voice tuning (leave blank for ElevenLabs defaults):
ELEVENLABS_SPEED=
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=

# --- STT ---
# azure  = server-side Azure STT (needs the two keys below)
# device = the phone transcribes and sends text; no Azure needed
STT_MODE=azure
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=

# --- where the backend lives (tools call it) ---
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=15
